module Dry
  class CLI
    module UI
      VERSION: String

      class Error < StandardError
      end

      class NonInteractiveError < Error
      end

      def ui: () -> Console

      private def ui_streams: () -> { out: untyped, err: untyped, input: untyped }
      private def ui_stream: (Symbol name, Symbol legacy_name) -> untyped
      private def ui_options: () -> Hash[Symbol, untyped]

      def self.raw: (untyped stream) -> untyped

      def self.configure: () { (Configuration config) -> void } -> Configuration
      def self.config: () -> Configuration
      def self.reset!: () -> void
      def self.started_at: () -> Time

      module Flags
        OPTIONS: Hash[Symbol, Hash[Symbol, Hash[Symbol, untyped]]]
        OPTIONAL_VALUES: Array[Symbol]
        SWITCHES: Array[String]

        def self.arguments: (Array[String] argv, ?switches: Array[String]) -> Array[String]
        def self.switches: (untyped command) -> Array[String]
        def flags: (*Symbol names) -> Array[Symbol]
      end

      class Invocation
        attr_reader executable: String
        attr_reader action: String?
        attr_reader name: String
        attr_reader started_at: Time
        attr_reader directory: String

        def self.new: (executable: String, action: String?, name: String, started_at: Time, directory: String) -> Invocation
        def self.for: (?untyped command, ?program: String, ?started_at: Time, ?directory: String) -> Invocation
        def self.root: (String directory) -> String
        def basename: () -> String
        def report_path: (String? value) -> String?
        def log_path: (String? value) -> String?
      end

      class Report
        def color?: () -> true
      end

      class Logging
        LEVELS: Array[String]
        FORMATS: Hash[String, Symbol]
        INSPECT_LIMIT: Integer
        FRAME_LIMIT: Integer

        def self.level: (String | Symbol name) -> Symbol
        def self.formatter: (String | Symbol name) -> untyped
        def self.formats: () -> Array[String]
        def self.logger: (String name) -> untyped
        def self.locals: (Exception exception) -> Array[Hash[Symbol, untyped]]?
        def self.record: (Exception exception) -> void
        def initialize: (String? target, io: untyped, level: String | Symbol, format: String | Symbol) -> void
        def run: [T] () { () -> T } -> T
      end

      module Reporting
        def output: [T] (?String? value) { (untyped io) -> T } -> T
        def logging: [T] (String? value, ?level: String | Symbol, ?format: String | Symbol) { () -> T } -> T
        def with_flags: [T] (?output: String?, ?log: String?, ?log_level: String | Symbol, ?log_format: String | Symbol, **untyped) { (untyped io) -> T } -> T
        def logger: () -> untyped
        def log_exception: (Exception exception, ?String? message, ?level: String | Symbol) -> nil
      end

      class Configuration
        type spinner_definition = Symbol | { interval: Numeric, frames: Array[String] | String }
        type bar_definition = Symbol | { complete: String, incomplete: String }

        def spinner_format: (?spinner_definition value) -> spinner_definition
        def spinner_format=: (spinner_definition value) -> spinner_definition
        def bar_format: (?bar_definition value) -> bar_definition
        def bar_format=: (bar_definition value) -> bar_definition
        def bar_color: (?Symbol? value) -> Symbol?
        def bar_color=: (Symbol? value) -> Symbol?
        def bar_background: (?Symbol? value) -> Symbol?
        def bar_background=: (Symbol? value) -> Symbol?
        def bar_failed_color: (?Symbol? value) -> Symbol?
        def bar_failed_color=: (Symbol? value) -> Symbol?
        def bar_aux_color: (?Symbol? value) -> Symbol?
        def bar_aux_color=: (Symbol? value) -> Symbol?
        def spinner_frames: () -> Array[String]
        def spinner_frame_seconds: () -> Float
        def bar_complete: () -> String
        def bar_incomplete: () -> String
      end

      class Line
        def self.call: [T] (^(Line) -> T job, Line line) -> T
        def initialize: () ?{ (String detail) -> void } -> void
        def detail: () -> String
        def detail=: (_ToS? text) -> void
        def fail: (?_ToS? reason) -> self
        def failed?: () -> bool
        def reason: () -> String?
        def summary: (String label) -> String
      end

      module Widgets
        class Progress
          class Handle
            type outcome = :ok | :aux | :failed

            OUTCOMES: Array[outcome]

            def total: () -> Integer?
            def total=: (Integer value) -> Integer
            def color: () -> Symbol?
            def current: () -> Integer
            def counts: () -> { ok: Integer, aux: Integer, failed: Integer }
            def advance: (?Integer step, ?as: outcome) -> self
            def fail: (?_ToS? reason) -> self
            def failed?: () -> bool
            def reason: () -> String?
            def finish: () -> self
            def summary: (String label) -> String
          end
        end
      end

      class Stop
        def stopped?: () -> bool
        def stop!: () -> self
        def trap: [T] (?String signal) { (Stop stop) -> T } -> T
      end

      class Console
        include Reporting

        def debug: (*_ToS paragraphs, ?width: Integer?) -> nil
        def info: (*_ToS paragraphs, ?width: Integer?) -> nil
        def success: (*_ToS paragraphs, ?width: Integer?) -> nil
        def warn: (*_ToS paragraphs, ?width: Integer?) -> nil
        def error: (*_ToS paragraphs, ?width: Integer?) -> nil
        def fatal: (*_ToS paragraphs, ?width: Integer?) -> nil
        def box: (*_ToS paragraphs, ?title: String?, ?level: Symbol?, ?width: Integer?) -> nil
        def status: (*_ToS words, ?level: Symbol) -> nil
        def popup: (*_ToS paragraphs, ?title: String?, ?width: Integer?) -> nil
        def spinner: [T] (String label) { (Line line) -> T } -> T
        def multi_spinner: (String title, ?concurrent: (bool | Integer), ?stop: Stop?) { (untyped spinners) -> void } -> Array[untyped]
        def progress: [T] (String label, total: Integer, ?color: Symbol?) { (Widgets::Progress::Handle progress) -> T } -> T
        def legend: (?failed: _ToS?, ?aux: _ToS?, ?ok: _ToS?) -> nil
        def multi_progress: (String title, ?concurrent: (bool | Integer), ?count: (:units | :jobs), ?total: Integer?, ?stop: Stop?) { (untyped bars) -> void } -> Array[untyped]
        def stoppable: [T] () { (Stop stop) -> T } -> T
        def status_bar: [T] (?String? title, ?hints: Array[String] | String) { () -> T } -> T
        def tasks: (?String? title, ?concurrent: (bool | Integer)) { (untyped tasks) -> void } -> nil
        def table: (Array[Array[_ToS]] rows, ?header: Array[_ToS]?) -> nil
        def prompt: (String question, ?default: untyped, ?choices: (Array[String] | Hash[String, untyped])?) -> untyped
        def confirm: (String question, ?default: bool, ?yes: bool) -> bool
      end
    end
  end
end
